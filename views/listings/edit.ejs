<%layout("/layouts/boilerplate.ejs")%>
<body>
   <div class="row">
      <div class="col-8 offset-2">
         <h3>Edit This listing</h3>
         <form method="post" action="/listings/<%=listing._id%>?_method=patch "
            novalidate class="needs-validation" enctype="multipart/form-data">
            <div>
               <label for="title" class="form-label">Title</label>
               <input type="text" name="listings[title]" id="title" required 
                  class="form-control" value=<%=listing.title%>>
               <div class="valid-feedback">Title looks good</div>
               <div class="invalid-feedback">Enter valid title</div>
            </div>
            <div>
               <label for="description" class="form-label">Description</label>
               <textarea type="text" name="listings[description]"
                  id="description" class="form-control" required
                  value=<%=listing.description%>></textarea>
               <div class="valid-feedback">Description looks good</div>
               <div class="invalid-feedback">Enter valid Description</div>
            </div>
            <div>
               <label for="image" class="form-label">Upload New Image </label>
               <input type="file" name="listings[image]" id="image"
                  class="form-control">
            </div>
            <br>
            <div class="mb-3">
               Original Listing Image<br>
               <img src="<%=listing.image.url %>" height="150px" width="300px">
            </div>

            <div>
               <label for="price" class="form-label">Price</label>
               <input type="number" name="listings[price]" id="price" required
                  class="form-control" value=<%=listing.price%>>
               <div class="valid-feedback">Price looks good</div>
               <div class="invalid-feedback">Enter valid Price</div>
            </div>

            <div>
               <label for="location" class="form-label">Location</label>
               <input type="text" name="listings[location]" id="location" required
                  class="form-control" value=<%=listing.location%>>
               <div class="valid-feedback">Location looks good</div>
               <div class="invalid-feedback">Enter valid Location</div>
            </div>

            <div>
               <label for="country" class="form-label">Country</label>
               <input type="text" name="listings[country]" id="country" required
                  class="form-control" value=<%=listing.country%>>
               <div class="valid-feedback">Country Name looks good</div>
               <div class="invalid-feedback">Enter valid Country Name</div>
            </div>
            <br>
            <button class="btn btn-dark add-btn">Update</button>
            <br>
         </form>
      </div>
   </div>
</body>