<%layout("/layouts/boilerplate.ejs")%>
<body>
    <div class="row mt-3">
        <div class="col-8 offset-3">
            <h3><%=result.title%></h3>
            <div class="card show-card listing-card">
                <img src="<%=result.image.url%>" class="card-img-top show-image"
                    alt="...">
                <div class="card-img-overlay">
                </div>
                <div class="card-body">
                    <p class="card-text">
                        <p><i>Owned by @<%=result.owner.username%></i></p>
                       <p> <%=result.description%></p>
                        <p>&#8377;<%=result.price.toLocaleString("en-IN")%>/Night</p>
                        <p> <%=result.location%></p>
                        <p><%=result.country%></p>
                        </p>
                </div>
            </div>
                
        <% if(currUser &&currUser._id.equals(result.owner._id)) {%>
            <div class="show-btn">
                <a href="/listings/<%=result._id%>/edit"
                    class="btn btn-dark">Edit....</a>
                <form method="post"
                    action="/listings/<%=result._id%>?_method=delete">
                    <button class="btn btn-dark add-btn">Delete</button>
                </form>
            </div>
            <% } %>
            <div>
                 <% if(currUser){ %>
                <hr>
                <h4>Leave a Reveiw</h4>
                <form action="/listings/<%=result._id%>/review" method="post"
                    class="needs-validation" novalidate>
                    <div class="mb-3 mt-3">

                        <label for="rating" class="form-label">Rating</label>
                        <input type="range" min="1" max="5" id="rating"
                            name="review[rating]" class="form-range" required />
                        <div class="valid-feedback">Review looks good</div>
                        <div class="invalid-feedback">Enter a valid review</div>
                    </div>
         
                    <div class="mb-3">

                        <label for="comment" class="form-label">Comments</label>
                        <textarea name="review[comment]" id="comment" cols="30"
                            rows="5" class="form-control"></textarea>
                        <div class="valid-feedback">Comment looks good</div>
                        <div class="invalid-feedback">Please add some comment
                            for reviews.</div>
                    </div>
                    <button class="btn btn-dark">Submit</button>
                </form>
                <% } %>
                <hr>

                <div class="review">
                    <p><b>All Reviews:</b></p>
                    <div class="row">
                    <%for(const review of result.reviews){%>
                    <div class="card col-5 ms-3 mb-3">
                            <div class="card-body">
                                <h5 class="card=title">@<%=review.author.username%></h5>
                                <p class="card-text"><%=review.comment%></p>
                                <h3>Rating</h3>
                                <p class="starability-result" data-rating=<%=review.rating%>>
                                Rated: <%=review.rating%>
                                </p>
                                <form method="post" action="/listings/<%= result._id %>/review/<%=review._id%>?_method=delete">
                                    <button class="btn btn-outline-dark">Delete</button>
                                </form>

                            </div>
                    </div>
                    <%}%>
                    </div>
                </div>
               
            </div>
        </div>
    </div>

</body>
